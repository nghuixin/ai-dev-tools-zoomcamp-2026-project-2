# Copy to .env (git-ignored) to move host ports when they clash with other local projects.
# Both `make` and `docker compose` read it.
ATLAS_PORT=8000
GRAFANA_PORT=3000
PROM_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200

# Optional: a Neon branch for `make run-neon`. `make run` ignores these and stays on SQLite.
# Pooled (-pooler host) for the app; direct (no -pooler) for Alembic migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
